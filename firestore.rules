rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      // 'group' (A/B) is set by the researcher in the console; users cannot change it.
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'group'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.get('group', null) == resource.data.get('group', null);
    }
    match /users/{userId}/habits/{habitId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
